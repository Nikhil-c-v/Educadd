{
  "version": 2,
  "buildCommand": "node vercel-build.js",
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/index.js" },
    { "src": "/api-config.json", "dest": "/frontend/api-config.json", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "src": "/site-config.js", "dest": "/frontend/site-config.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "src": "/(.*\\.html)", "dest": "/frontend/$1" },
    { "src": "/(.*\\.(png|jpg|svg|ico|css|xml|txt))", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
