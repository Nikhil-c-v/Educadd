{
  "version": 2,
  "builds": [
    { "src": "backend/api/index.js", "use": "@vercel/node" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/index.js" },
    { "src": "/admin", "dest": "/frontend/admin.html", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "src": "/sitemap.xml", "dest": "/frontend/sitemap.xml" },
    { "src": "/robots.txt", "dest": "/frontend/robots.txt" },
    { "src": "/site-config.js", "dest": "/frontend/site-config.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "src": "/(.*\\.html)", "dest": "/frontend/$1", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "src": "/(.*\\.(png|jpg|svg|ico|css|xml|txt))", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/frontend/index.html", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } }
  ]
}
